{
  "name": "im-sorry-letter-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "typecheck:worker": "tsc -p worker/tsconfig.json --pretty false",
    "test": "vitest run",
    "test:browser": "node tests/browser-smoke.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --port 8787 --local",
    "check": "npm run lint && npm run typecheck && npm run typecheck:worker && npm run test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/sacramento": "^5.2.8",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.12",
    "vitest": "^5.0.3"
  }
}
