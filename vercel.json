{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/gift/:path*", "destination": "/index.html" },
    { "source": "/studio/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ]
}
